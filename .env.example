# =============================================================================
# SportsMatch Tokyo - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# Supabase (Required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Database (Required)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# Email - Resend (Required for email features)
# =============================================================================
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=SportsMatch Tokyo <noreply@sportsmatch.tokyo>

# =============================================================================
# Redis - Upstash (Required for production rate limiting)
# =============================================================================
# Get these from https://console.upstash.com/redis
# Without these, rate limiting falls back to in-memory (not suitable for production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# =============================================================================
# Cron Jobs (Required for scheduled tasks)
# =============================================================================
CRON_SECRET=your-random-secret-for-cron-jobs

# =============================================================================
# App Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_VERSION=1.0.0

# =============================================================================
# Optional - Analytics & Monitoring
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================================================
# Vercel → Telegram webhook bridge  (app/api/vercel-webhook)
# =============================================================================
# HMAC-SHA1 secret set when you create the webhook in the Vercel dashboard.
# Generate with: openssl rand -hex 32
VERCEL_WEBHOOK_SECRET=

# Only events for THIS project name will be forwarded to Telegram.
VERCEL_PROJECT_NAME=sportsmatch-tokyo

# Telegram bot (from @BotFather). The bot must be able to message the chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
